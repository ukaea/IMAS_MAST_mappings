{
    "ids_properties/homogeneous_time": {
        "map_type": "VALUE",
        "value": 0
    },
    "time": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "AMC_PLASMA CURRENT"
        }
    },

    "ip": {
        "map_type": "VALUE",
        "value": 1
    },
    "ip[#]/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "AMC_PLASMA CURRENT"
        },
        "scale": "{{ UNIT_SF }}"
    },
    "ip[#]/time": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "AMC_PLASMA CURRENT",
            "time": true
        }
    },
    "ip[#]/method_name": {
        "map_type": "VALUE",
        "value": "IP Rogowski measurement"
    },

    "flux_loop": {
        "map_type": "VALUE",
        "value": "{{ length(FLUX_LOOPS) }}"
    },
    "flux_loop[#]/name": {
        "map_type": "VALUE",
        "value": "{{ FL_NAME }}"
    },
    "flux_loop[#]/type/name": {
        "map_type": "VALUE",
        "value": "flux"
    },
    "flux_loop[#]/type/index": {
        "map_type": "VALUE",
        "value": 1
    },
    "flux_loop[#]/position/r": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ FL_NAME }}",
            "key": "coordinate.r"
        }
    },
    "flux_loop[#]/position/z": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ FL_NAME }}",
            "key": "coordinate.z"
        }
    },
    "flux_loop[#]/position/phi": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ FL_NAME }}",
            "key": "coordinate.phi"
        },
        "scale": "{{ DEG2RAD }}"
    },
    "flux_loop[#]/flux/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "AMB_FL/{{ FL_NAME }}"
        },
        "scale": -1.0
    },
    "flux_loop[#]/flux/time": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "AMB_FL/{{ FL_NAME }}",
            "time": true
        }
    },

    "b_field_pol_probe": {
        "map_type": "VALUE",
        "value": "{{ length(BPOL_PROBES) }}"
    },
    "b_field_pol_probe[#]/name": {
        "map_type": "VALUE",
        "value": "{{ BPOL_NAME }}"
    },
    "b_field_pol_probe[#]/type/name": {
        "map_type": "VALUE",
        "value": "mirnov"
    },
    "b_field_pol_probe[#]/type/index": {
        "map_type": "VALUE",
        "value": 2
    },
    "b_field_pol_probe[#]/type/description": {
        "map_type": "VALUE",
        "value": "Mirnov Probe"
    },
    "b_field_pol_probe[#]/position/r": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "coordinate.r"
        }
    },
    "b_field_pol_probe[#]/position/z": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "coordinate.z"
        }
    },
    "b_field_pol_probe[#]/position/phi": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "coordinate.phi"
        },
        "scale": "{{ DEG2RAD }}"
    },
    "b_field_pol_probe[#]/area": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "geometry.areaAve"
        }
    },
    "b_field_pol_probe[#]/length": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "geometry.length"
        }
    },
    "b_field_pol_probe[#]/turns": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "geometry.nturnsTotal"
        }
    },
    "b_field_pol_probe[#]/poloidal_angle": {
        "map_type": "EXPR",
        "PARAMETERS": {
            "Z": "_temp/pickup[#]/unit_vector/z",
            "R": "_temp/pickup[#]/unit_vector/r"
        },
        "EXPR": "mod(2*PI-atan2(Z,R), 2*PI)"
    },
    "_temp/pickup[#]/unit_vector/r": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "orientation.unit_vector.r"
        }
    },
    "_temp/pickup[#]/unit_vector/z": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "orientation.unit_vector.z"
        }
    },
    "b_field_pol_probe[#]/toroidal_angle": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "orientation.unit_vector.phi"
        }
    },
    "b_field_pol_probe[#]/field/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "{{ BPOL_NAME }}"
        }
    },
    "b_field_pol_probe[#]/field/time": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "time": true
        }
    },

    "_COMMENT_b_field_phi_probe": "MAST has no dedicated toroidal field probes. b_field_phi_probe is not mapped."
}