{
    "ids_properties/homogeneous_time": {
        "map_type": "VALUE",
        "value": 0
    },

    "coil": {
        "map_type": "VALUE",
        "value": "{{ length(PF_COILS) }}"
    },
    "coil[#]/name": {
        "map_type": "VALUE",
        "value": "{{ PF_NAME }}"
    },
    "coil[#]/identifier": {
        "map_type": "VALUE",
        "value": "PF_COIL_{{ #0 + 1 }}"
    },
    "coil[#]/current/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "{{ PF_CURRENT_NAME }}"
        },
        "scale": "{{ PF_CURRENT_SCALE }}"
    },
    "coil[#]/current/time": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "{{ PF_CURRENT_NAME }}",
            "time": true
        }
    },
    "coil[#]/function": {
        "map_type": "VALUE",
        "value": 1
    },
    "coil[#]/function[#]/index": {
        "map_type": "VALUE",
        "value": "{{ FUNCTION }}"
    },
    "coil[#]/element": {
        "map_type": "DIMENSION",
        "DIM_PROBE": "_coil[#]/element_size"
    },
    "_coil[#]/element_size": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "/magnetics/pfcoil/{{ PF_GEOM_STEM }}",
            "key": "centreR"
        }
    },
    "coil[#]/element[#]/identifier": {
        "map_type": "VALUE",
        "value": "C{{ #0 + 1 }}_E{{ #1 + 1 }}"
    },
    "coil[#]/element[#]/turns_with_sign": {
        "map_type": "VALUE",
        "value": 1.0
    },
    "coil[#]/element[#]/geometry/geometry_type": {
        "map_type": "VALUE",
        "value": 2
    },
    "coil[#]/element[#]/geometry/rectangle/r": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "/magnetics/pfcoil/{{ PF_GEOM_STEM }}",
            "key": "centreR"
        },
        "slice": "[{{ #1 }}]"
    },
    "coil[#]/element[#]/geometry/rectangle/z": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "/magnetics/pfcoil/{{ PF_GEOM_STEM }}",
            "key": "centreZ"
        },
        "slice": "[{{ #1 }}]"
    },
    "coil[#]/element[#]/geometry/rectangle/width": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "/magnetics/pfcoil/{{ PF_GEOM_STEM }}",
            "key": "dR"
        },
        "slice": "[{{ #1 }}]"
    },
    "coil[#]/element[#]/geometry/rectangle/height": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "/magnetics/pfcoil/{{ PF_GEOM_STEM }}",
            "key": "dZ"
        },
        "slice": "[{{ #1 }}]"
    },
    "coil[#]/element[#]/area": {
        "map_type": "EXPR",
        "PARAMETERS": {
            "WIDTH": "coil[#]/element[#]/geometry/rectangle/width",
            "HEIGHT": "coil[#]/element[#]/geometry/rectangle/height"
        },
        "EXPR": "WIDTH * HEIGHT"
    },
    "supply": {
        "map_type": "VALUE",
        "value": "{{ length(PF_SUPPLIES) }}"
    },
    "supply[#]/name": {
        "map_type": "VALUE",
        "value": "{{ PF_PS_NAME }}"
    },
    "supply[#]/identifier": {
        "map_type": "VALUE",
        "value": "SUPPLY_{{ #0 + 1 }}"
    },
    "supply[#]/voltage/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "{{ SUPPLY_VOLTAGE_NAME }}"
        }
    },
    "supply[#]/voltage/time": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "{{ SUPPLY_VOLTAGE_NAME }}",
            "time": true
        }
    }
}
